DB_URL=jdbc:postgresql://localhost:5432/events_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DRIVER=org.postgresql.Driver

JPA_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=none
JPA_SHOW_SQL=true
JPA_PREFERRED_INSTANT_TYPE=TIMESTAMP
JPA_LOB_NON_CONTEXTUAL=true

SPRING_LIQUIBASE_ENABLED=true

JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_TIMEOUT=60000

HMAC_SECRET=hmac_secret

MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=2525
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key
MAIL_FROM=your_verified_sender@example.com

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

SERVER_PORT=8081

APP_NAME=events
